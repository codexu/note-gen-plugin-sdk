{
  "name": "note-gen-plugin-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Public development tools for the NoteGen plugin ecosystem.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "check:contract": "pnpm --filter @notegen/plugin-api check:contract",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "pnpm -r --if-present clean"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.20.0"
}
